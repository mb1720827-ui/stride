# Copy to .env.local and fill in. Never commit .env.local.

# Supabase Dashboard > Project Settings > API (publishable/anon key only; never the secret/service-role key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Web Push. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Your app's URL (sent to push services to identify the sender).
VAPID_SUBJECT=https://your-app.vercel.app
# A long random string. Supabase pg_cron sends it to /api/tick; only its SHA-256 hash goes in stride_tick_secret.
STRIDE_TICK_SECRET=
# Optional: only this account's chat requests reach the AI (your laptop worker signs in as it anyway).
STRIDE_OWNER_EMAIL=

# --- Worker only (your laptop). Not needed on Vercel. ---
# The account the worker signs in as: your own Stride account.
STRIDE_EMAIL=you@example.com
STRIDE_PASSWORD=your-password
# Optional: your Takeaway app, so your saved videos can become skill resources and Today shows due Recall cards.
TAKEAWAY_URL=
# Optional: model for Claude Code (e.g. sonnet), how often to check for requests, and the path to Claude Code.
STRIDE_MODEL=
STRIDE_POLL_SECONDS=15
CLAUDE_BIN=
